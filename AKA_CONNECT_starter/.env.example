# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # serveur uniquement — ne jamais exposer

# IA (recherche web + pré-qualification + rédaction)
ANTHROPIC_API_KEY=
# AGENCY_PROFILE="Agence AKA — services, clientèle cible…"   (optionnel)

# Cron (Vercel envoie Authorization: Bearer CRON_SECRET)
CRON_SECRET=
CRON_MAX_CAMPAIGNS=1   # campagnes par exécution (limite de 300 s par fonction)

# Leads entrants (formulaire du site, Zapier/Make…) : POST /api/leads?key=...
LEADS_WEBHOOK_SECRET=

# Envoi des courriels approuvés (https://resend.com)
RESEND_API_KEY=
RESEND_FROM="Agence AKA <info@agenceaka.ca>"
REPLY_TO=info@agenceaka.ca

# Facebook / Instagram Lead Ads (webhook leadgen)
FB_VERIFY_TOKEN=
FB_APP_SECRET=
FB_PAGE_ACCESS_TOKEN=
